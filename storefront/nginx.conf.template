# nginx for the built storefront (Dockerfile). ${API_UPSTREAM} is filled in when the container starts.
server {
    listen 80;
    root /usr/share/nginx/html;

    # Photos for try-on and voice clips go through /api.
    client_max_body_size 25m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Docker's DNS, so a restarted API container is found at its new address.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api ${API_UPSTREAM};

    location /api/ {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # AI try-on renders and Pip turns can take a while; the API has its own deadlines.
        proxy_read_timeout 330s;
        proxy_send_timeout 330s;
    }

    # Vite's hashed bundles never change.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Client-side routes (/product/12, /orders/…) all load the app.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
