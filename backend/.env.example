# Shared by the API (NestJS) and AI (FastAPI) services. Copy to .env and adjust.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cartly
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Ports. The API stays off 3000, which Next.js and most Node servers take by default. The storefront
# and admin panel read API_PORT from here for their /api proxy (via ../backend/.env).
API_PORT=4100
AI_PORT=8001
# 127.0.0.1 rather than localhost, so an IPv6-only process on the same port can't answer instead.
AI_SERVICE_URL=http://127.0.0.1:8001
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:5174,http://localhost:4174
# Shared secret the AI service uses when calling internal API endpoints
INTERNAL_API_KEY=change-me
# Optional: real-time voice via LiveKit (leave empty to use browser speech)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------- AI features (all optional; each one falls back when its key is empty) ----------
# Pip's brain: Claude. Understands and answers in any language, knows the shopper's season and
# festivals, and talks only about Cartly's own catalog. Without a key Pip uses the English rule brain.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
# To try other models through OpenRouter, put an OpenRouter id in AGENT_MODEL (or ADMIN_AI_MODEL), e.g. the free
# nvidia/nemotron-3-super-120b-a12b:free, and set OPENROUTER_API_KEY. Ids with a "/" go there, others to Claude.
# OPENROUTER_API_KEY=
AGENT_EFFORT=low
# Claude Sonnet 5.5 only: "between_tools" turns thinking off (fewer output tokens). Empty = the model's default.
# AGENT_THINKING=
# Admin photo checks and product suggestions; empty = AGENT_MODEL.
# ADMIN_AI_MODEL=
# One Claude attempt of a chat turn (one retry; keep it under the deadline), and the whole turn: under the API
# gateway's 45 s. Admin photo checks and product suggestions allow 40 s an attempt.
# AGENT_TIMEOUT=35
# AGENT_DEADLINE=38

# AI try-on: FASHN Try-On Max re-renders the shopper's photo wearing the look. Without a key
# the fitting room uses its on-device quick preview.
FASHN_API_KEY=
TRYON_MODE=balanced
TRYON_RESOLUTION=1k
# AI renders per shopper per hour (cached steps don't count)
TRYON_HOURLY_LIMIT=30

# Multilingual voice: ElevenLabs speech-to-text (detects the language) and text-to-speech.
# Without a key the browser's own speech recognition and voices are used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v4
# Pip's voice: warm and gentle by default (stability 0.45, similarity 0.8, style 0.3, speed 0.96).
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY=0.8
# ELEVENLABS_STYLE=0.3
# ELEVENLABS_SPEED=0.96
ELEVENLABS_STT_MODEL=scribe_v2

# Meta Model API (dev.meta.ai), optional and switchable per job. AGENT_MODEL / ADMIN_AI_MODEL=muse-spark-1.3 puts Pip on
# Muse Spark ($1.25/$4.25 per M tokens: about 10x Haiku 5.5; Bangla not documented, so run pip_model_eval first).
# META_API_KEY=
# TRYON_PROVIDER=fashn      meta: Muse Image edits, $0.01 a render (try-on quality untested: compare with tryon_eval)
# STT_PROVIDER=elevenlabs   meta: Muse Voice Transcribe (Bengali among 25 languages, $0.18/h, WAV only)
# CUTOUT_PROVIDER=local     meta: SAM 3.1 masks ($2.50 per 1,000; needs pip install meta-sam-parser, SAM License)

# ---------- Emails to shoppers (Admin → Emails) ----------
# smtp://user:pass@host:587 or smtps://…:465. Empty: emails stay in the Outbox as "failed: no mail server".
# SMTP_URL=
# MAIL_FROM=Cartly <hello@cartly.dev>

# ---------- Running at scale (see SCALING.md) ----------
# Behind a CDN or load balancer: proxy hops to trust for the shopper's IP (rate limits). Leave unset
# when the API faces the internet directly, or anyone could choose their IP with X-Forwarded-For.
# TRUST_PROXY=1
# Postgres connections per API instance; (API instances × this) + AI instances × 10 < max_connections.
# DB_POOL_MAX=10
# Requests per minute per signed-in shopper, else per IP.
# THROTTLE_LIMIT=120
# Evictable caches (try-on renders, voice clips, greetings, search): a Redis with maxmemory and
# maxmemory-policy allkeys-lru, so carts in REDIS_URL are never evicted. Empty = REDIS_URL.
# CACHE_REDIS_URL=redis://localhost:6380/0

# ---------- Payments (bKash, Nagad, Rocket + cards via SSLCommerz, cash on delivery) ----------
# Gateway credentials are entered in the admin panel (Payments → Settings) and stored encrypted with
# this key. Any long random string (e.g. `openssl rand -base64 36`); changing it means re-entering them.
PAYMENT_SECRETS_KEY=
# Where shoppers come back to after paying, and the API's public URL the gateways call back.
STOREFRONT_URL=http://localhost:5173
# API_PUBLIC_URL=https://api.example.com
# Orders not paid online within this many minutes are cancelled and their stock released.
# PAYMENT_TIMEOUT_MINUTES=30

# ---------- AI spend controls ----------
# Daily caps in USD (0 = no cap), metered in the AI service and shown on the admin System page.
# Past a cap the feature falls back until 00:00 UTC: Pip to the rule brain, try-on to the quick
# preview, voice to the browser's own.
CLAUDE_DAILY_BUDGET_USD=0
TRYON_DAILY_BUDGET_USD=0
VOICE_DAILY_BUDGET_USD=0
# Pip's free checks before Claude: obvious off-topic tasks (homework, poems, code, trivia...), prompt
# injection, empty input and plain thank-yous get a reply from templates in the shopper's language.
# off | shadow (count what it would catch, change nothing) | enforce. Anything unsure still goes to Claude.
# PIP_GATE=enforce
# Languages the template replies exist in; messages in any other language always go to Claude.
# PIP_TEMPLATE_LANGS=en,bn,bn-Latn,hi,hi-Latn,ur,ar,es
# A plain "thanks" / "bye" / "আল্লাহ হাফেজ" gets a template reply.
# PIP_CLOSERS=true
# Off-topic turns within PIP_STRIKE_WINDOW seconds before a cooldown (0 = off); during the cooldown
# (seconds) messages with nothing about shopping get a template.
# PIP_STRIKES=3
# PIP_STRIKE_WINDOW=1800
# PIP_COOLDOWN=600
# Claude turns per UTC day before Pip switches to quick mode (its built-in answers; 0 = no limit): per
# signed-in shopper, per guest chat, per guest network (a hashed IP; mobile networks share IPs, so high).
# PIP_DAILY_TURNS_ACCOUNT=200
# PIP_DAILY_TURNS_SESSION=80
# PIP_DAILY_TURNS_GUEST_IP=1000
# With CLAUDE_DAILY_BUDGET_USD set: past this share of it, guests with an empty cart go to quick mode first.
# PIP_SOFT_CAP_RATIO=0.8
# Identical requests from shoppers Pip knows nothing about (no name, cart or orders) share replies.
# PIP_REPLY_CACHE=true
# PIP_REPLY_CACHE_VARIANTS=2
# PIP_REPLY_CACHE_TTL=3600
# A signed-in shopper's own opener is kept for the same facts in the same hour (re-opening Pip, Start over).
# PIP_GREETING_CACHE=true
# Cache lifetime of the shared persona + catalog prompt: 1h (pays off whenever Pip is quiet for 5+ minutes) or 5m.
# PIP_SYSTEM_CACHE_TTL=1h
# The "also called" names in Pip's catalog prompt (search uses them either way); false only after the eval.
# PIP_PROMPT_KEYWORDS=true
# The websocket chat (/agent/ws) isn't used by the storefront and has no gateway throttle: off by default.
# AGENT_WS_ENABLED=false
# Sample-model try-on looks are shared by all shoppers and kept this long (seconds).
# TRYON_SAMPLE_CACHE_TTL=604800
# Unit prices behind the spend estimates; set them to your plans.
# FASHN_USD_PER_CREDIT=0.075
# TTS_USD_PER_1K_CHARS=0.10
# STT_USD_PER_HOUR=0.22

# Uploaded product photos: stored here and served by the API under /api/v1/uploads/
# UPLOAD_DIR=../uploads
# API_PUBLIC_URL=http://localhost:4100

# Visitor journeys: a MaxMind GeoLite2-City .mmdb for city-level locations when no CDN location headers
# arrive (Cloudflare CF-IPCountry/CF-IPCity, Vercel X-Vercel-IP-*). Free download with a MaxMind account.
# GEOIP_DB=/path/to/GeoLite2-City.mmdb
# Visits and page views older than this are deleted (days).
# TRACK_RETENTION_DAYS=180
