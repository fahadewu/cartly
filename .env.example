# Optional settings for the Docker install (docker compose / ./cartly). Copy to .env and fill in what you need;
# everything works without this file. Restart with ./cartly up after a change.
# (backend/.env is the non-Docker dev setup's file; this one is only for Docker.)

# ---------- AI features: each one switches on with its key, and falls back without it ----------
# Pip on Claude: any language in (Bangla, Banglish, Hindi…), the same language out. Without it, an English rule brain.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
# AI try-on (FASHN): the shopper's photo re-rendered wearing the look. Without it, a quick preview for accessories.
FASHN_API_KEY=
TRYON_MODE=balanced
# Voice (ElevenLabs): speech-to-text that detects the language, and Pip's voice. Without it, the browser's own.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Meta Model API (dev.meta.ai), optional: Muse Spark for Pip (AGENT_MODEL=muse-spark-1.3), Muse Image try-on,
# Muse Voice Transcribe and SAM 3.1 cut-outs. Each switches on separately; the defaults stay as they are.
# Test first (Bangla especially): backend/ai/scripts/pip_model_eval.py --configs muse-spark-1.3
META_API_KEY=
# TRYON_PROVIDER=meta
# STT_PROVIDER=meta
# CUTOUT_PROVIDER=meta     (also needs: pip install meta-sam-parser, SAM License)

# Daily spend caps in USD, per vendor (0 = no cap). Past a cap the feature falls back until 00:00 UTC.
# Worth setting whenever someone else (a judge, a tester) uses your keys.
CLAUDE_DAILY_BUDGET_USD=0
TRYON_DAILY_BUDGET_USD=0
VOICE_DAILY_BUDGET_USD=0

# ---------- Emails to shoppers (Admin → Emails) ----------
# Without these, every email lands in the bundled Mailpit (http://localhost:8025) and nobody else gets it.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Your Shop <hello@yourshop.com>

# ---------- Ports on this machine ----------
CARTLY_STOREFRONT_PORT=5173
CARTLY_ADMIN_PORT=5174
# The API reference (/docs); bound to this machine only.
CARTLY_API_PORT=4100
# Mailpit's inbox for the emails Cartly sends.
CARTLY_MAIL_PORT=8025

# ---------- Running a real store (not a demo) ----------
# production: no demo card, and a fresh database stays empty (no demo store or test kit) until you restore your
# store into it with ./cartly restore. CARTLY_SEED=demo loads the demo store anyway.
# NODE_ENV=production
# The "Use it" test-login buttons follow NODE_ENV: shown for the demo, hidden for production. Force them
# with true/false (baked into the build: ./cartly up rebuilds).
# VITE_SHOW_TEST_ACCOUNTS=false
# Public addresses, when it runs behind a domain (payment gateways and couriers call API_PUBLIC_URL back).
# STOREFRONT_URL=https://shop.example.com
# API_PUBLIC_URL=https://shop.example.com
# CORS_ORIGIN=https://shop.example.com,https://admin.example.com
# The secrets are generated on the first start and kept in the cartly-secrets volume. Set them here only to
# carry them over from another install (PAYMENT_SECRETS_KEY unlocks saved gateway and courier credentials).
# JWT_SECRET=
# INTERNAL_API_KEY=
# PAYMENT_SECRETS_KEY=
# Every other setting in backend/.env.example works here too (Pip's limits, caches, try-on options…).
